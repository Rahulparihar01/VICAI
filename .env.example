# Prefer the Supabase pooler connection when the runtime has no IPv6 access.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres
# Optional: when DATABASE_URL is Supabase's direct URL, this transparently
# routes it through the IPv4 session pooler while preserving its password.
SUPABASE_POOLER_HOST=aws-0-your-project-region.pooler.supabase.com

# Application settings
APP_URL=http://127.0.0.1:8000
VICAI_ENV=development

# Admin login (server only; use a strong, unique password)
ADMIN_ID=vicai_admin
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Authentication (generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=vicai-api
JWT_AUDIENCE=vicai-app

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
